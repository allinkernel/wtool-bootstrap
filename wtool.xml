<?xml version="1.0" encoding="UTF-8"?>
<!--
  wtool-bootstrap 自举为 wtool 项目。

  它提供"长期存在"的环境变量（重启 shell 后依然可用）：
    WTOOL_PREFIX      = $HOME/.wtool/usr（编译安装前缀，wsw.sh 只准往这里装）
    WTOOL_OS_ID / WTOOL_OS_VERSION / WTOOL_OS_CODENAME / WTOOL_OS_LIKE
    WTOOL_ARCH / WTOOL_JOBS
  并把 $WTOOL_PREFIX/bin 与项目 bin/（wtool 命令 wrapper）加进 PATH。

  priority=5：最早加载，保证后面所有项目都能用到这些变量。

       ⚠️ 旧注释里写的 WTOOL_SRC_DIR / WTOOL_REF **不存在**（全仓 grep 零命中）；
       引擎真正导出的是 WTOOL_PROJECT_ID/DIR/ROOT、WTOOL_WORKSPACE、WTOOL_HOME、
       WTOOL_PREFIX、WTOOL_JOBS/ARCH、WTOOL_OS_*、WTOOL_ARTIFACTS、WTOOL_STATE_DIR；
       <source> 任务另有 WTOOL_SOURCE_DIR / WTOOL_SOURCE_REF。见 docs/spec.md §10。
-->
<wtool schema="1" id="bootstrap" priority="5">

  <!-- shell 集成：两个 shell 各一份，内容等价。
       priority=5 也写在这儿（priority 越小越早加载），保证后面所有项目
       都能用到这些变量。 -->
  <zshrc  src="env.zsh"  priority="5"/>
  <bashrc src="env.bash" priority="5"/>

</wtool>
